// The GameProfile record a game's AppProfileHost call receives. Kept apart
// from the host so it is checked without a graphical backend.
#import "std/bundle_host"
#import "kryon/hosted_values"
#import "gamekit_contract"

using HostValueKind;

// The fields of an encoded GameProfile; the answer borrows them until the
// next AppProfileHost call.
GameProfileCodec :: struct {
    fields: [4]HostField
}

GameProfileField :: (field: *HostField, name: string, value: string) {
    field.name = HostTextData(name)
    field.value = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
        .data = HostTextData(value), .length = cast(usize)value.count}
}

// PROFILE as the GameProfile record a game's AppProfileHost receives.
GameEncodeProfile :: (profile: GameProfile, codec: *GameProfileCodec) -> HostValue {
    value: HostValue
    value.kind = cast(s32)HostRecord
    value.type_name = HostTextData("GameProfile")
    value.fields = *codec.fields[0]
    value.field_count = 4
    GameProfileField(*codec.fields[0], "identity", profile.identity)
    GameProfileField(*codec.fields[1], "display_name", profile.display_name)
    GameProfileField(*codec.fields[2], "language", profile.language)
    GameProfileField(*codec.fields[3], "avatar", profile.avatar)
    return value
}
