// The fixture's own asset preparation: run as PROGRAM RESOURCES GENERATED.
#import "std/file"
#import "std/byte_text_linux"

main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 3 { return 2 }
    resources := TextFromCString(argv[1])
    builder: Vec(u8)
    BuilderPrint(*builder, "%/prepared.txt", resources)
    if !WriteEntireFile(BuilderFinish(builder), "prepared by the game\n") { return 1 }
    return 0
}
