// The fixture's add-on: it reuses the game's code through its library.
#import "apps/node_types"
#import "apps/node_app"
#import "fixture"
host_api :: #system_library "host_api";
ReadAppUiHost :: () -> AppUiFrame #foreign host_api;

#program_export
Main :: () -> s32 { return RunNodeApp(EditorFrame, EditorBack) }

EditorFrame :: (message: AppMessage) -> bool {
    unused message
    frame := ReadAppUiHost()
    return frame.width >= 0 && FixtureScore(2) == 20
}

EditorBack :: (message: AppMessage) -> bool {
    unused message
    return true
}
