// A minimal game-v1 game: it answers frames and shares FixtureScore with its
// add-on.
#import "apps/node_types"
#import "apps/node_app"
// Written by `ziran tool gamekit pack` into the bundle's generated folder.
#import "translations"
host_api :: #system_library "host_api";
ReadAppUiHost :: () -> AppUiFrame #foreign host_api;

FixtureScore :: (level: s32) -> s32 { return level * 10 }

#program_export
Main :: () -> s32 { return RunNodeApp(FixtureFrame, FixtureBack) }

FixtureFrame :: (message: AppMessage) -> bool {
    frame := ReadAppUiHost()
    return frame.width >= 0 && message.locale.count >= 0
}

FixtureBack :: (message: AppMessage) -> bool {
    return FixtureScore(1) == 10 && GameLocaleText(message.locale, "fixture_title").count > 0
}
